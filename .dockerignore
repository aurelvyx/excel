# Sólo entran al contexto las fuentes necesarias; excluye .env, .tmp y muestras privadas.
**
!package.json
!pnpm-lock.yaml
!pnpm-workspace.yaml
!apps/
!apps/api/
!apps/api/package.json
!apps/api/tsconfig*.json
!apps/api/nest-cli.json
!apps/api/src/
!apps/api/src/**
!apps/api/templates/
!apps/api/templates/reportes/
!apps/api/templates/reportes/*.xlsx
!apps/api/templates/reportes/registro.json
!apps/api/Dockerfile
!apps/web/
!apps/web/package.json
!apps/web/tsconfig*.json
!apps/web/vite.config.ts
!apps/web/index.html
!apps/web/src/
!apps/web/src/**
!apps/web/public/
!apps/web/public/**
!apps/web/Dockerfile
!infra/
!infra/proxy/
!infra/proxy/Caddyfile*

# Las excepciones de directorio no deben incorporar enlaces ni entornos locales.
**/node_modules
**/dist
**/.env
**/.env.*
**/.tmp
**/*.tsbuildinfo
**/*.log
**/test
**/*.spec.ts
