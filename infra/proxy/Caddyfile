{
	admin off
	auto_https disable_redirects
}

https://localhost {
	tls internal
	encode zstd gzip
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
		X-Frame-Options DENY
	}
	@api path /api /api/*
	handle @api {
		reverse_proxy api:3000 {
			header_up X-Forwarded-For {client_ip}
		}
	}
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
