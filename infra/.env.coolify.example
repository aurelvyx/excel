# Configurar como variables privadas de ejecución en Coolify, sin subir este archivo completado.
POSTGRES_DB=excel
POSTGRES_USER=excel
POSTGRES_PASSWORD=
APP_DB_USER=excel_app
APP_DB_PASSWORD=
# Origen público, p. ej. https://academico.example.com (sin :8080 ni barra final).
# El dominio de web se configura aparte en Coolify apuntando al puerto interno 8080.
WEB_ORIGINS=
# IP/CIDR exclusivos del proxy Coolify que conecta con web, separados por espacios.
# Sustituir loopback tras revisar la red real; no confiar en todos los rangos privados.
TRUSTED_PROXY_CIDRS=127.0.0.1/32 ::1/128
