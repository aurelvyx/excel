{
  "name": "centro-idiomas-excel",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": { "node": ">=24" },
  "scripts": {
    "env:setup": "node infra/scripts/setup-env.mjs",
    "typecheck": "pnpm -r typecheck",
    "check": "pnpm lint && pnpm typecheck && pnpm build && pnpm test && pnpm test:e2e && pnpm test:tools",
    "test:tools": "node --test infra/scripts/*.test.mjs",
    "test:db": "node infra/scripts/test-database.mjs",
    "test:b10": "node infra/scripts/test-database.mjs --b10",
    "b10:mediciones": "node infra/scripts/measure-enrollments.mjs",
    "b10:plantillas": "node infra/scripts/template-registry.mjs",
    "db:migrate": "pnpm --filter api migration:run",
    "db:revert": "pnpm --filter api migration:revert",
    "db:status": "pnpm --filter api migration:show",
    "db:seed:demo": "pnpm --filter api seed:demo",
    "admin:bootstrap": "pnpm --filter api admin:bootstrap",
    "dev:api": "pnpm --filter api start:dev",
    "dev:web": "pnpm --filter web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "pnpm --filter api test",
    "test:e2e": "pnpm --filter api test:e2e",
    "db:up": "docker compose --env-file infra/.env -f infra/compose.yaml up -d --wait --wait-timeout 120",
    "db:down": "docker compose --env-file infra/.env -f infra/compose.yaml down",
    "db:logs": "docker compose --env-file infra/.env -f infra/compose.yaml logs -f postgres",
    "db:config": "docker compose --env-file infra/.env -f infra/compose.yaml config --quiet"
  }
}
