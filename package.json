{
  "name": "centro-idiomas-excel",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": { "node": ">=24" },
  "scripts": {
    "env:setup": "node infra/scripts/setup-env.mjs",
    "typecheck": "pnpm -r typecheck",
    "check": "pnpm lint && pnpm typecheck && pnpm build && pnpm test && pnpm test:e2e && pnpm test:tools",
    "test:tools": "node --test infra/scripts/*.test.mjs",
    "test:db": "node infra/scripts/test-database.mjs",
    "test:b10": "node infra/scripts/test-database.mjs --b10",
    "test:b20": "node infra/scripts/test-database.mjs --b20",
    "test:b21": "node infra/scripts/test-database.mjs --b21",
    "test:deploy": "node infra/scripts/test-deployment.mjs",
    "db:backup": "node infra/scripts/respaldo/cli.mjs backup",
    "db:restore:verify": "node infra/scripts/respaldo/cli.mjs verify",
    "db:backup:retention": "node infra/scripts/respaldo/cli.mjs retention",
    "deploy:setup": "node infra/scripts/setup-deploy-env.mjs",
    "deploy:config": "docker compose --env-file infra/.env.deploy -f infra/compose.deploy.yaml config --quiet",
    "deploy:build": "docker compose --env-file infra/.env.deploy -f infra/compose.deploy.yaml build",
    "deploy:db": "docker compose --env-file infra/.env.deploy -f infra/compose.deploy.yaml up -d --wait postgres",
    "deploy:migrate": "docker compose --env-file infra/.env.deploy -f infra/compose.deploy.yaml run --rm ops",
    "deploy:status": "docker compose --env-file infra/.env.deploy -f infra/compose.deploy.yaml run --rm ops node dist/database/migrate.js show",
    "deploy:admin": "docker compose --env-file infra/.env.deploy -f infra/compose.deploy.yaml run --rm -e BOOTSTRAP_ADMIN_USERNAME -e BOOTSTRAP_ADMIN_PASSWORD ops node dist/database/bootstrap-admin.js",
    "deploy:up": "docker compose --env-file infra/.env.deploy -f infra/compose.deploy.yaml up -d --wait",
    "deploy:down": "docker compose --env-file infra/.env.deploy -f infra/compose.deploy.yaml down",
    "b10:mediciones": "node infra/scripts/measure-enrollments.mjs",
    "b10:plantillas": "node infra/scripts/template-registry.mjs",
    "b19:plantillas": "node infra/scripts/report-templates.mjs",
    "b20:mediciones": "node infra/scripts/pilot-measurements.mjs",
    "db:migrate": "pnpm --filter api migration:run",
    "db:revert": "pnpm --filter api migration:revert",
    "db:status": "pnpm --filter api migration:show",
    "db:seed:demo": "pnpm --filter api seed:demo",
    "admin:bootstrap": "pnpm --filter api admin:bootstrap",
    "dev:api": "pnpm --filter api start:dev",
    "dev:web": "pnpm --filter web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "pnpm --filter api test",
    "test:e2e": "pnpm --filter api test:e2e",
    "db:up": "docker compose --env-file infra/.env -f infra/compose.yaml up -d --wait --wait-timeout 120",
    "db:down": "docker compose --env-file infra/.env -f infra/compose.yaml down",
    "db:logs": "docker compose --env-file infra/.env -f infra/compose.yaml logs -f postgres",
    "db:config": "docker compose --env-file infra/.env -f infra/compose.yaml config --quiet"
  }
}
