NODE_ENV=development
# Docker usa 0.0.0.0; en desarrollo conservar el acceso local.
HOST=127.0.0.1
TRUST_PROXY_HOPS=0
PORT=3000
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=excel
DB_USER=excel
DB_PASSWORD=
DB_SSL=false
# Orígenes exactos separados por coma. En producción todos requieren HTTPS.
WEB_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:3000,http://localhost:3000
